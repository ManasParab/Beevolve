# PostgreSQL Connection (local PostgreSQL 18 / self-hosted)
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/beevolve_auth

# JWT Signing Secrets (generate long random hex/base64 strings)
JWT_SECRET_KEY=replace-with-64-char-random-secret
JWT_REFRESH_SECRET_KEY=replace-with-64-char-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# App URLs & Session Cookie Flags
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5500/Frontend
COOKIE_SECURE=false

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/oauth/google/callback

# Gmail SMTP & Email OTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Beevolve
EMAIL_OTP_EXPIRY_MINUTES=5
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_SECONDS=60
EMAIL_OTP_PEPPER=replace-with-random-pepper

# Razorpay Credentials
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx
